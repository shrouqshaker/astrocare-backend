{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocare.dev/schemas/symptom-checkin.schema.json",
  "title": "SymptomCheckin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "astronautId",
    "symptoms",
    "checkedAt",
    "utcOffsetMinutes",
    "environment",
    "source",
    "isSynthetic",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "astronautId": {
      "$ref": "common.schema.json#/$defs/astronautId"
    },
    "symptoms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/symptom"
      }
    },
    "checkedAt": {
      "$ref": "common.schema.json#/$defs/utcDateTime"
    },
    "utcOffsetMinutes": {
      "$ref": "common.schema.json#/$defs/utcOffsetMinutes"
    },
    "environment": {
      "$ref": "common.schema.json#/$defs/environmentId"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "isSynthetic": {
      "type": "boolean"
    },
    "chestPainTriage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "protocolId",
        "answers",
        "outcome"
      ],
      "properties": {
        "protocolId": {
          "type": "string"
        },
        "answers": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "questionId",
              "answer"
            ],
            "properties": {
              "questionId": {
                "type": "string"
              },
              "answer": {
                "enum": [
                  "yes",
                  "no",
                  "unsure"
                ]
              }
            }
          }
        },
        "outcome": {
          "enum": [
            "emergency_now",
            "urgent_contact"
          ]
        }
      }
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/utcDateTime"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "symptoms": {
            "contains": {
              "const": "none"
            }
          }
        },
        "required": [
          "symptoms"
        ]
      },
      "then": {
        "properties": {
          "symptoms": {
            "maxItems": 1
          }
        }
      }
    }
  ]
}
