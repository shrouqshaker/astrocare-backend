{
  "name": "astrocare-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AstroCare shared-contract v1 API, offline sync and demo analytics",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/contracts.test.js test/analytics.test.js",
    "contracts:verify": "node scripts/verify-contracts.js",
    "seed": "node scripts/seed.js",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^9.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
